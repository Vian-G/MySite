{
  "name": "vian-garg-portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "playwright test",
    "optimize:images": "svgo --multipass --config svgo.config.mjs src/assets/portrait.svg",
    "verify:images": "vite build --config vite.config.ts",
    "verify:build-budgets": "node scripts/verify-build-budgets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "svgo": "^4.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-imagetools": "^8.0.0",
    "wouter": "^3.3.5"
  }
}
